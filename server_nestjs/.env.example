# 服务端监听地址与数据目录
ADDR=:8787
DATA_DIR=./data

# PostgreSQL 连接串（PostgreSQL 唯一，无 SQLite）
PG_DSN=postgres://picoaide:change-me@127.0.0.1:5432/picoaide

# 引导管理员：仅当库里还没有任何 super_admin 时创建一次。
# 留空 BOOTSTRAP_ADMIN 则完全不自动建号；PICOAI_ADMIN_PASSWORD 缺失会启动失败。
BOOTSTRAP_ADMIN=
PICOAI_ADMIN_PASSWORD=

# master key 文件路径（AES-GCM 加密上游 API key；不存在时按管理员密码派生）
MASTER_KEY_FILE=./data/master.key
MASTER_KEY=

# 管理端 web 允许的来源（逗号分隔）；留空表示允许任意来源（仅开发用）
CORS_ORIGIN=

# 后台任务开关（余额发放 / 报表投递 / 审计清理）；只读副本或排障时置 false
SCHEDULER_ENABLED=true
