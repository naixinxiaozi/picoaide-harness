  "description": "PicoAide Harness 服务端 —— NestJS + drizzle-orm 重写",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
